# Create a Gemini API key in Google AI Studio and keep the real value in .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Set only when deployed behind HTTPS.
TRAO_COOKIE_SECURE=false

# Optional persistent hosted storage. When both are set, the Supabase adapter
# replaces the local JSON development store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
